import LocalCertification.Quantum.BornKernel
import LocalCertification.Quantum.HardStateInformation
import LocalCertification.Information.FiniteHistoryKL

set_option autoImplicit false
open scoped BigOperators ENNReal LocalCertification.Information
open LocalCertification.Extremal LocalCertification.Information MeasureTheory ProbabilityTheory InformationTheory Metric Set
noncomputable section
namespace LocalCertification.Quantum
universe u
variable {Z : Type u} [MeasurableSpace Z] {d n : ℕ}

/-- Iterated physical Born laws under a common measurable finite-prefix controller.
An operational executor will additionally prove absorption and identify active count with T∧m. -/
def stoppedBornPrefixLaw (ν : Measure Z) (ρ : QIT.State (CertificationGaussian.QuditIndex d n))
    (active : (t : ℕ) → Set (SlotHistory Z (CertificationGaussian.QuditIndex d n) t))
    (ha : ∀ t, MeasurableSet (active t))
    (setting : (t : ℕ) → SlotHistory Z (CertificationGaussian.QuditIndex d n) t → Fin n → CertificationGaussian.LocalUnitary d)
    (hm : ∀ t, Measurable (setting t)) (m : ℕ) :
    Measure (SlotHistory Z (CertificationGaussian.QuditIndex d n) m) :=
  prefixLaw ν (fun t => stopContinue (active t) (ha t)
    (controlledProductBornKernel d n ρ (setting t) (hm t))) m

instance stoppedBornPrefixLaw_probability (ν : Measure Z) [IsProbabilityMeasure ν]
    (ρ : QIT.State (CertificationGaussian.QuditIndex d n))
    (active : (t : ℕ) → Set (SlotHistory Z (CertificationGaussian.QuditIndex d n) t))
    (ha : ∀ t, MeasurableSet (active t))
    (setting : (t : ℕ) → SlotHistory Z (CertificationGaussian.QuditIndex d n) t → Fin n → CertificationGaussian.LocalUnitary d)
    (hm : ∀ t, Measurable (setting t)) (m : ℕ) :
    IsProbabilityMeasure (stoppedBornPrefixLaw ν ρ active ha setting hm m) := by
  unfold stoppedBornPrefixLaw
  infer_instance

/-- General finite-horizon physical information bound, for an arbitrary-universe measurable seed.
The two history marginals are those generated by their own actual input states. -/
theorem stoppedBornPrefixLaw_klDiv_le [NeZero d] (ν : Measure Z) [IsProbabilityMeasure ν]
    (ρ σ : QIT.State (CertificationGaussian.QuditIndex d n))
    (active : (t : ℕ) → Set (SlotHistory Z (CertificationGaussian.QuditIndex d n) t))
    (ha : ∀ t, MeasurableSet (active t))
    (setting : (t : ℕ) → SlotHistory Z (CertificationGaussian.QuditIndex d n) t → Fin n → CertificationGaussian.LocalUnitary d)
    (hm : ∀ t, Measurable (setting t)) (L : ℝ≥0∞)
    (hL : ∀ U, klDiv (productBornMeasure d n U ρ) (productBornMeasure d n U σ) ≤ L) (m : ℕ) :
    klDiv (stoppedBornPrefixLaw ν ρ active ha setting hm m)
      (stoppedBornPrefixLaw ν σ active ha setting hm m) ≤
      L * ∫⁻ h, prefixActiveCount active m h ∂stoppedBornPrefixLaw ν ρ active ha setting hm m := by
  let : Nonempty (CertificationGaussian.QuditIndex d n) := ⟨fun _ => ⟨0,Nat.pos_of_ne_zero (NeZero.ne d)⟩⟩
  exact prefixLaw_stopped_klDiv_le ν active ha
    (fun t => controlledProductBornKernel d n ρ (setting t) (hm t))
    (fun t => controlledProductBornKernel d n σ (setting t) (hm t)) L
    (fun t h _ => hL (setting t h)) m

/-- A concrete consumer of the proved calibrated Haar event, with no per-copy information bound
supplied as a hypothesis. This is a finite-prefix theorem; no terminal-validity claim is made. -/
theorem calibratedHaarGoodEvent_finite_prefix [NeZero d] (hd : 2 ≤ d) (r : ℕ)
    (ψ : sphere (0 : EuclideanSpace ℂ (CertificationGaussian.QuditIndex d n)) 1)
    (hN : (quditDualCertificate hd r).maxNode ≤ n) (C : ℝ)
    (W : CertificationGaussian.ComplexUnitary (CertificationGaussian.QuditIndex d n))
    (hW : W ∈ dualHaarGoodEvent hd r ψ hN C (dualOverlapCutoff d n)) (hn : 1 ≤ n)
    (b : ℝ) (hb0 : 0 < b) (hb1 : b < 1)
    (hlb : uncalibratedLowFidelity hd r (haarPureVector ψ W) hN < b)
    (ν : Measure Z) [IsProbabilityMeasure ν]
    (active : (t : ℕ) → Set (SlotHistory Z (CertificationGaussian.QuditIndex d n) t))
    (ha : ∀ t, MeasurableSet (active t))
    (setting : (t : ℕ) → SlotHistory Z (CertificationGaussian.QuditIndex d n) t → Fin n → CertificationGaussian.LocalUnitary d)
    (hm : ∀ t, Measurable (setting t)) (m : ℕ) :
    klDiv (stoppedBornPrefixLaw ν
      (calibratedNumeratorState hd r (haarPureVector ψ W) hN b hb0 hb1 hlb) active ha setting hm m)
      (stoppedBornPrefixLaw ν
        (calibratedDenominatorState hd r (haarPureVector ψ W) hN b hb0 hb1 hlb) active ha setting hm m) ≤
      ENNReal.ofReal (2*calibratedUniformWeight hd r b*(1+C/n)*
        CertificationGaussian.kernelVarianceScale d n (residualRadii (quditDualCertificate hd r))
          (residualWeight d (quditDualCertificate hd r)) +
        (4/calibratedUniformWeight hd r b)*((n : ℝ)^6/(d : ℝ)^n)) *
      ∫⁻ h, prefixActiveCount active m h ∂stoppedBornPrefixLaw ν
        (calibratedNumeratorState hd r (haarPureVector ψ W) hN b hb0 hb1 hlb) active ha setting hm m := by
  exact stoppedBornPrefixLaw_klDiv_le ν _ _ active ha setting hm _
    (calibratedHaarGoodEvent_klDiv hd r ψ hN C W hW hn b hb0 hb1 hlb) m

end LocalCertification.Quantum

import LocalCertification.Protocol.CompleteRecordLaw
import LocalCertification.Protocol.TerminalEvents
import Mathlib.Probability.Process.Filtration

set_option autoImplicit false
open MeasureTheory ProbabilityTheory Set LocalCertification.Information LocalCertification.Quantum
open scoped ENNReal LocalCertification.Information
noncomputable section
namespace LocalCertification.Protocol
universe u v w
variable {Z : Type u} {S : Type v} {O : Type w}
    [MeasurableSpace Z] [MeasurableSpace S] [MeasurableSpace O]
    [Inhabited S] [Inhabited O] [Fintype O] [MeasurableSingletonClass O]

/-- The uncompleted sigma algebra generated by the original seed and first m legal primitive slots. -/
@[instance_reducible] def legalPrefixSigma (R : RawRules Z S O) (m : ℕ) : MeasurableSpace (legalPaths R) :=
  MeasurableSpace.comap (fun p : legalPaths R => rawPrefix m p.val) inferInstance

omit [MeasurableSingletonClass O] in
theorem legalPrefixSigma_mono (R : RawRules Z S O) : Monotone (legalPrefixSigma R) := by
  apply monotone_nat_of_le_succ
  intro m
  exact MeasurableSpace.comap_le_comap_of_eq_comp
    (fun h : SlotHistory Z O m × Option O => h.1) measurable_fst rfl

/-- The causal finite-history filtration on all legal paths, including zero-probability branches. -/
def legalFiltration (R : RawRules Z S O) : Filtration ℕ (inferInstance : MeasurableSpace (legalPaths R)) where
  seq := legalPrefixSigma R
  mono' := legalPrefixSigma_mono R
  le' m := ((rawPrefix_measurable m).comp measurable_subtype_coe).comap_le

/-- Complete finite public records generate exactly the same raw filtration on the legal subtype. -/
theorem legalPrefixSigma_eq_public (R : RawRules Z S O) (m : ℕ) :
    legalPrefixSigma R m = MeasurableSpace.comap
      (fun p : legalPaths R => publicPrefix R m (rawPrefix m p.val)) inferInstance := by
  apply le_antisymm
  · apply MeasurableSpace.comap_le_comap_of_eq_comp
      (decodePublicPrefix m) (decodePublicPrefix_measurable m)
    funext p
    exact (decodePublicPrefix_publicPrefix R m (rawPrefix m p.val) (p.property m)).symm
  · exact MeasurableSpace.comap_le_comap_of_eq_comp (publicPrefix R m)
      (publicPrefix_measurable R m) rfl

variable {d n : ℕ} [NeZero d]
attribute [local instance] executionOutcomeInhabited executionSettingInhabited

/-- The actual first stopping event is determined pointwise by this finite raw history. -/
theorem legalPath_stoppingTime_le (P : QuditProtocol Z d n) (p : legalPaths P.toRawRules) (m : ℕ) :
    executionTime P p.val ≤ (m : WithTop ℕ) ↔ rawPrefix m p.val ∉ activePrefix P.toRawRules m := by
  change stoppingTime P.toRawRules p.val.1 (fun k => (p.val.2 k).getD default) ≤ (m : WithTop ℕ) ↔ _
  rw [stoppingTime_le_iff]
  change (¬actionContinues (execPrefix P.toRawRules m
    (logicalPrefix P.toRawRules p.val.1 (fun k => (p.val.2 k).getD default) m)).2 = true) ↔ _
  rw [legalPath_logicalPrefix]
  rfl

/-- T≤m belongs to the original finite filtration; no completion by an input law is involved. -/
theorem legal_stopped_measurable (P : QuditProtocol Z d n) (m : ℕ) :
    MeasurableSet[legalFiltration P.toRawRules m]
      {p : legalPaths P.toRawRules | executionTime P p.val ≤ (m : WithTop ℕ)} := by
  have h := (comap_measurable (fun p : legalPaths P.toRawRules => rawPrefix m p.val))
    (activePrefix_measurable P.toRawRules m).compl
  have he : {p : legalPaths P.toRawRules | executionTime P p.val ≤ (m : WithTop ℕ)} =
      (fun p : legalPaths P.toRawRules => rawPrefix m p.val) ⁻¹' (activePrefix P.toRawRules m)ᶜ := by
    ext p
    exact legalPath_stoppingTime_le P p m
  rw [he]
  exact h

/-- A finite reported decision is measurable at the same finite horizon. -/
theorem legal_stopped_decision_measurable (P : QuditProtocol Z d n) (j : Fin 2) (m : ℕ) :
    MeasurableSet[legalFiltration P.toRawRules m]
      {p : legalPaths P.toRawRules | executionTime P p.val ≤ (m : WithTop ℕ) ∧ executionDecision P p.val = j} := by
  have h := (comap_measurable (fun p : legalPaths P.toRawRules => rawPrefix m p.val))
    (prefixDecisionEvent_measurable P j m)
  have he : {p : legalPaths P.toRawRules | executionTime P p.val ≤ (m : WithTop ℕ) ∧ executionDecision P p.val = j} =
      (fun p : legalPaths P.toRawRules => rawPrefix m p.val) ⁻¹' prefixDecisionEvent P j m := by
    ext p
    exact (prefixDecisionEvent_iff_of_consistent P p.val p.property j m).symm
  rw [he]
  exact h

/-- The next-copy active event is already measurable before that copy is drawn. -/
theorem legal_active_measurable (P : QuditProtocol Z d n) (m : ℕ) :
    MeasurableSet[legalFiltration P.toRawRules m]
      {p : legalPaths P.toRawRules | (m : WithTop ℕ) < executionTime P p.val} := by
  simpa only [Set.compl_ofPred, not_le] using (legal_stopped_measurable P m).compl

/-- Exact stopping and terminal-decision events retain their finite-horizon measurability, also at zero. -/
theorem legal_stop_exact_decision_measurable (P : QuditProtocol Z d n) (j : Fin 2) (m : ℕ) :
    MeasurableSet[legalFiltration P.toRawRules m]
      {p : legalPaths P.toRawRules | executionTime P p.val = (m : WithTop ℕ) ∧ executionDecision P p.val = j} := by
  cases m with
  | zero =>
    simp only [Nat.cast_zero]
    have he : {p : legalPaths P.toRawRules | executionTime P p.val = (0 : WithTop ℕ) ∧ executionDecision P p.val = j} =
        {p : legalPaths P.toRawRules | executionTime P p.val ≤ (0 : WithTop ℕ) ∧ executionDecision P p.val = j} := by
      ext p
      simp only [Set.mem_ofPred_eq, nonpos_iff_eq_zero]
    rw [he]
    exact legal_stopped_decision_measurable P j 0
  | succ m =>
    have hprev : MeasurableSet[legalFiltration P.toRawRules (m+1)]
        {p : legalPaths P.toRawRules | executionTime P p.val ≤ (m : WithTop ℕ)} :=
      (legalFiltration P.toRawRules).mono (Nat.le_succ m) _ (legal_stopped_measurable P m)
    have he : {p : legalPaths P.toRawRules | executionTime P p.val = ((m+1 : ℕ) : WithTop ℕ) ∧ executionDecision P p.val = j} =
        {p : legalPaths P.toRawRules | executionTime P p.val ≤ ((m+1 : ℕ) : WithTop ℕ) ∧ executionDecision P p.val = j} \
        {p : legalPaths P.toRawRules | executionTime P p.val ≤ (m : WithTop ℕ)} := by
      ext p
      simp only [Set.mem_sdiff, Set.mem_ofPred_eq]
      cases h : executionTime P p.val with
      | top =>
        have hne : (⊤ : WithTop ℕ) ≠ ((m+1 : ℕ) : WithTop ℕ) := (WithTop.natCast_ne_top (m+1)).symm
        have hnle : ¬(⊤ : WithTop ℕ) ≤ ((m+1 : ℕ) : WithTop ℕ) := not_le_of_gt (WithTop.natCast_lt_top (m+1))
        simp only [hne, hnle, false_and]
      | coe t =>
        change ((t : ℕ∞) = ((m+1 : ℕ) : ℕ∞) ∧ executionDecision P p.val = j) ↔
          (((t : ℕ∞) ≤ ((m+1 : ℕ) : ℕ∞) ∧ executionDecision P p.val = j) ∧ ¬(t : ℕ∞) ≤ (m : ℕ∞))
        simp only [ENat.natCast_inj, ENat.natCast_le_natCast]
        omega
    rw [he]
    exact (legal_stopped_decision_measurable P j (m+1)).diff hprev

end LocalCertification.Protocol

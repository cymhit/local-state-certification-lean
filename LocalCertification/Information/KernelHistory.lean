import LocalCertification.Information.KernelVariational

/-!
# Seeded finite-history laws and cumulative information

A history retains its initial classical seed and each complete record in order.
Its law is the actual iterated composition product of history-dependent kernels.
Two inputs use the same seed law; their finite-record relative entropy is bounded
by the sum of the expected one-step information costs under the first input.
-/

set_option autoImplicit false
open MeasureTheory ProbabilityTheory
open scoped ENNReal BigOperators

namespace LocalCertification.Information.KernelHistory

universe u

/-- The seed together with n ordered complete records, represented recursively. -/
def FullHistory (S Ω : Type u) : ℕ → Type u
  | 0 => S
  | n + 1 => FullHistory S Ω n × Ω

instance fullHistoryMeasurableSpace {S Ω : Type u} [MeasurableSpace S]
    [MeasurableSpace Ω] (n : ℕ) : MeasurableSpace (FullHistory S Ω n) :=
  match n with
  | 0 => inferInstanceAs (MeasurableSpace S)
  | n + 1 => @Prod.instMeasurableSpace (FullHistory S Ω n) Ω
      (fullHistoryMeasurableSpace n) inferInstance

variable {S Ω : Type u} [MeasurableSpace S] [MeasurableSpace Ω]

/-- The actual finite execution law generated by a seed and conditional records. -/
noncomputable def prefixLaw (seed : Measure S)
    (κ : ∀ n, Kernel (FullHistory S Ω n) Ω) : ∀ n, Measure (FullHistory S Ω n)
  | 0 => seed
  | n + 1 => (prefixLaw seed κ n) ⊗ₘ (κ n)

@[simp] theorem prefixLaw_zero (seed : Measure S)
    (κ : ∀ n, Kernel (FullHistory S Ω n) Ω) : prefixLaw seed κ 0 = seed := rfl

@[simp] theorem prefixLaw_succ (seed : Measure S)
    (κ : ∀ n, Kernel (FullHistory S Ω n) Ω) (n : ℕ) :
    prefixLaw seed κ (n + 1) = (prefixLaw seed κ n) ⊗ₘ (κ n) := rfl

instance prefixLaw_isProbability (seed : Measure S) [IsProbabilityMeasure seed]
    (κ : ∀ n, Kernel (FullHistory S Ω n) Ω) [∀ n, IsMarkovKernel (κ n)]
    (n : ℕ) : IsProbabilityMeasure (prefixLaw seed κ n) := by
  induction n with
  | zero => exact inferInstanceAs (IsProbabilityMeasure seed)
  | succ n ih =>
    let _ := ih
    change IsProbabilityMeasure ((prefixLaw seed κ n) ⊗ₘ (κ n))
    infer_instance

/-- The shared seed contributes zero information; the actual execution laws
accumulate only the expected conditional costs. -/
theorem prefixLaw_klDiv_le
    (seed : Measure S) [IsProbabilityMeasure seed]
    (κ η : ∀ n, Kernel (FullHistory S Ω n) Ω)
    [∀ n, IsMarkovKernel (κ n)] [∀ n, IsMarkovKernel (η n)]
    (c : ∀ n, FullHistory S Ω n → ℝ)
    (hc : ∀ n, Integrable (c n) (prefixLaw seed κ n))
    (hcpos : ∀ n x, 0 ≤ c n x)
    (hstep : ∀ n x, InformationTheory.klDiv (κ n x) (η n x) ≤ ENNReal.ofReal (c n x))
    (m : ℕ) :
    InformationTheory.klDiv (prefixLaw seed κ m) (prefixLaw seed η m) ≤
      ENNReal.ofReal (∑ i ∈ Finset.range m, ∫ x, c i x ∂prefixLaw seed κ i) := by
  induction m with
  | zero =>
    change InformationTheory.klDiv seed seed ≤ ENNReal.ofReal (0 : ℝ)
    rw [InformationTheory.klDiv_self]
    simp
  | succ m ih =>
    have hnonneg : 0 ≤ ∑ i ∈ Finset.range m, ∫ x, c i x ∂prefixLaw seed κ i :=
      Finset.sum_nonneg fun i _ => integral_nonneg (hcpos i)
    have h := klDiv_compProd_le_of_pointwise_bound
      (prefixLaw seed κ m) (prefixLaw seed η m) (κ m) (η m)
      (∑ i ∈ Finset.range m, ∫ x, c i x ∂prefixLaw seed κ i)
      hnonneg ih (c m) (hc m) (hcpos m) (hstep m)
    rw [prefixLaw_succ, prefixLaw_succ, Finset.sum_range_succ]
    exact h

/-- After stopping, the two kernels agree and contribute no information.
Only the probabilities of still being active enter the finite-prefix bound. -/
theorem prefixLaw_klDiv_le_activeCount
    (seed : Measure S) [IsProbabilityMeasure seed]
    (κ η : ∀ n, Kernel (FullHistory S Ω n) Ω)
    [∀ n, IsMarkovKernel (κ n)] [∀ n, IsMarkovKernel (η n)]
    (active : ∀ n, Set (FullHistory S Ω n))
    (hactive : ∀ n, MeasurableSet (active n)) (Γ : ℝ) (hΓ : 0 ≤ Γ)
    (hstopped : ∀ n x, x ∉ active n → κ n x = η n x)
    (hstep : ∀ n x, x ∈ active n →
      InformationTheory.klDiv (κ n x) (η n x) ≤ ENNReal.ofReal Γ)
    (m : ℕ) :
    InformationTheory.klDiv (prefixLaw seed κ m) (prefixLaw seed η m) ≤
      ENNReal.ofReal (Γ * ∑ i ∈ Finset.range m, (prefixLaw seed κ i).real (active i)) := by
  classical
  let c : ∀ n, FullHistory S Ω n → ℝ := fun n => (active n).indicator (fun _ => Γ)
  have hc : ∀ n, Integrable (c n) (prefixLaw seed κ n) := fun n =>
    (integrable_const Γ).indicator (hactive n)
  have hcpos : ∀ n x, 0 ≤ c n x := by
    intro n x
    by_cases hx : x ∈ active n <;> simp [c, hx, hΓ]
  have hbound : ∀ n x, InformationTheory.klDiv (κ n x) (η n x) ≤ ENNReal.ofReal (c n x) := by
    intro n x
    by_cases hx : x ∈ active n
    · simpa [c, hx] using hstep n x hx
    · rw [hstopped n x hx, InformationTheory.klDiv_self]
      exact bot_le
  have hsum : (∑ i ∈ Finset.range m, ∫ x, c i x ∂prefixLaw seed κ i) =
      Γ * ∑ i ∈ Finset.range m, (prefixLaw seed κ i).real (active i) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    simp [c, integral_indicator (hactive i), smul_eq_mul, mul_comm]
  rw [← hsum]
  exact prefixLaw_klDiv_le seed κ η c hc hcpos hbound m

end LocalCertification.Information.KernelHistory
